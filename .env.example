# Copia este archivo como .env y completa los valores. .env está en .gitignore:
# nunca se sube al repo. En Render, estas mismas variables se cargan en el panel
# (Environment), no en archivos.

# Base de datos persistente (turso.tech). Vacío = archivo local data/edhplatform.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# «Continuar con Google» (console.cloud.google.com → Credenciales)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cuenta de prueba fija para entrar sin registrarse (opcional).
# Ojo: en la página publicada, cualquiera que adivine estos datos puede entrar con ella.
DEMO_USER=
DEMO_PASSWORD=
